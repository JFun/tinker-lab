# Godot 4 editor cache & generated import data
.godot/
# Per-asset import sidecars Godot writes when it scans non-game PNGs (e.g. the
# App Store screenshots under docs/) — editor cache, not app content.
*.import

# Build outputs: iOS exports, crash logs, UI screenshots, .pck/.ipa
/build/

# Committed iOS shell lives at repo root (TinkerLab.xcodeproj + TinkerLab/ +
# GoogleService-Info.plist). The heavy, regenerated binaries are NOT committed:
#   - .pck is refreshed every deploy via `godot --export-pack`
#   - the xcframeworks come from the Godot iOS export templates
/TinkerLab.pck
/TinkerLab.xcframework/
/MoltenVK.xcframework/
# Xcode user state & SPM local checkout (regenerated by xcodebuild)
**/xcuserdata/
**/*.xcuserstate
**/project.xcworkspace/xcuserdata/
**/.swiftpm/
/TinkerLab.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/configuration/

# Local Claude Code state (keep shared .claude/settings.json tracked)
.claude/settings.local.json
.claude/worktrees/

# macOS
.DS_Store
